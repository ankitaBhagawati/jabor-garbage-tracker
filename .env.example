# Every environment variable Jabor reads, with no real values.
# Local: copy to .env.local (gitignored) and fill in STAGING values only.
# Vercel: Production scope gets production values; Preview scope (branch staging) gets staging values.

# ── Public (bundled into the browser JS; never put secrets in VITE_* vars) ──
# vite.config.js refuses to build if a VITE_* name contains SECRET, SERVICE_ROLE, PRIVATE, PASSWORD or TOKEN.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon (publishable) key. The browser reads it as VITE_SUPABASE_ANON_KEY.
# The api/ functions read SUPABASE_ANON_KEY first and fall back to VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
# Optional. SupportJaborSection.jsx falls back to the live button id when unset.
VITE_RAZORPAY_PAYMENT_BUTTON_ID=pl_your_payment_button_id
# Cloudflare Turnstile site key. Read at BUILD time: after changing it in Vercel, redeploy.
# It must belong to the same widget as TURNSTILE_SECRET_KEY, and that widget's hostname list must
# include the site's domain (production and staging use separate widgets).
# Local testing key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Sentry DSN (one project for browser and api; the same value as SENTRY_DSN). Unset = Sentry off.
VITE_SENTRY_DSN=

# ── Environment name (not secret; also exposed to the browser through vite.config.js envPrefix) ──
# production | staging. Tags Sentry events; APP_ENV=staging turns GA4 off. Unset locally = development.
APP_ENV=

# ── Server-only (Vercel env vars or .env.local; read by api/*) ──
# Sentry DSN for the api/ functions. Same value as VITE_SENTRY_DSN.
SENTRY_DSN=
# Build-time only (Vercel). When SENTRY_AUTH_TOKEN is set, the build uploads hidden source maps
# to Sentry and deletes them from dist. Never use a VITE_ prefix.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional overrides. When unset, api/ uses the VITE_ values above.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses RLS. Used by api/reports/submit.js and api/cleanup-proofs.js. NEVER use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional. api/_lib/server.js uses it when VITE_CLOUDINARY_CLOUD_NAME is unset.
CLOUDINARY_CLOUD_NAME=
# Local testing secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Shared rate limits across serverless instances (Upstash Redis).
# KV_REST_API_URL / KV_REST_API_TOKEN (Vercel KV integration names) are accepted as fallbacks.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Same value must be set as a Supabase edge function secret for jabor-notify.
NOTIFY_SHARED_SECRET=generate-with-openssl-rand-hex-32

# ── Supabase edge function secrets (set with `supabase secrets set`, not in Vercel) ──
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_REPLY_TO=
# NOTIFY_SHARED_SECRET=
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# ── Local tooling only (.env.local; never in Vercel) ──
# Personal access token for the Supabase CLI.
SUPABASE_ACCESS_TOKEN=
# STAGING only. Postgres connection string from Supabase dashboard > Connect (session pooler).
STAGING_DB_URL=postgresql://postgres.your-staging-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
STAGING_PROJECT_REF=your-staging-project-ref
# Playwright smoke tests (npm run test:smoke). Defaults to https://staging.jabor.in; production is refused.
PLAYWRIGHT_BASE_URL=
# Vercel > Project > Settings > Deployment Protection > Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=
