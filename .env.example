# ── Public (bundled into the browser JS — never put secrets in VITE_* vars) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_RAZORPAY_PAYMENT_BUTTON_ID=pl_your_live_payment_button_id
# Cloudflare Turnstile site key. Local testing key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── Server-only (Vercel env vars / .env.local; read by api/*) ──
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Bypasses RLS. Only api/reports.js and api/cleanup-proofs.js use it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
# Local testing secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Shared rate limits across serverless instances (Upstash Redis, free tier is fine).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Same value must be set as a Supabase edge function secret for jabor-notify.
NOTIFY_SHARED_SECRET=generate-with-openssl-rand-hex-32
